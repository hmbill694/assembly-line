/target

# `.assembly/config.toml` is tracked configuration — the tool reads it from a
# committed ref, so it must stay out of this ignore rule. `.assembly/jobs/`
# is local job state and should never be committed, so it alone is ignored.
.assembly/jobs/

# macOS writes these into any directory Finder has looked at.
.DS_Store

# devenv / direnv working state. `devenv.lock` IS committed — it pins the
# toolchain inputs — but everything under .devenv/ is a local cache.
.devenv/
.direnv/
