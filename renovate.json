{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "GitHub Actions: automerge non-major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Dev dependencies: group and automerge non-major",
      "matchDepTypes": ["dev-dependencies", "build-dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Runtime dependencies: a human reads these",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "description": "Majors wait a week and always get a review",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Docker base images: pin to digests too",
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Action digest bumps are mechanical once the version is unchanged",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "The builder's rust tag must match rust-toolchain.toml's channel, which renovate does not bump; bump both together by hand.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rust"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG MISE_VERSION=(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases"
    }
  ]
}
